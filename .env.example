# Copy this file to ".env" in the project root and fill in real values.
# Never commit the real ".env" file.

# Server port (Render injects its own PORT automatically in production)
PORT=5000

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/90-day-program?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# URL of the frontend, used for CORS in local dev (Vite default port shown)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Not required until Phase 4 (Gemini evaluation). Leave blank for now.
GEMINI_API_KEY=
